# Koneksi TiDB Cloud Serverless (MySQL-compatible, Port 4000, SSL aktif)
# Format: mysql://<user>:<password>@<host>:4000/<database>?ssl={"rejectUnauthorized":true}
DATABASE_URL="mysql://USER.root:PASSWORD@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/dimsum_pos"

# Secret minimal 32 karakter untuk enkripsi session cookie autentikasi
SESSION_SECRET="ganti-dengan-secret-acak-minimal-32-karakter-aman"

# Nama kedai UMKM yang tampil di UI dan struk
NUXT_PUBLIC_STORE_NAME="Kedai Dimsum Nusantara"
